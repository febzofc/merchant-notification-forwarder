<?xml version="1.0" encoding="utf-8"?>
<!--
  Hanya memercayai certificate system. CA yang dipasang user (mis. untuk
  debugging proxy) tidak dipercaya, dan seluruh trafik wajib HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
